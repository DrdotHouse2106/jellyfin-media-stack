# Kopieren nach .env und anpassen:  cp .env.example .env
# Die .env enthält Passwörter – niemals committen (steht in .gitignore).

PUID=1000
PGID=1000
TZ=Europe/Berlin
# Gruppe "render" bzw. "video" auf dem Host:  getent group render video
RENDER_GID=44

# Ein gemeinsamer Datenordner für Downloads UND Medien → Hardlinks funktionieren
#   /data/downloads/...   (sabnzbd)
#   /data/media/filme     (radarr)
#   /data/media/serien    (sonarr)
DATA_DIR=/data
MEDIA_DIR=/data/media
ANIME_DIR=/data/anime
ANIME_TRAILER_DIR=/data/anime-trailer
MUSIC_DIR=/data/musik
AUDIOBOOKS_DIR=/data/hoerbuecher
BOOKS_DIR=/data/buecher
MANGA_DIR=/data/manga
YOUTUBE_DIR=/data/youtube

# m3u-editor (Live-TV)
M3U_APP_URL=http://SERVER-IP
PG_PASSWORD=bitte-aendern
REDIS_PASSWORD=bitte-aendern
M3U_PROXY_TOKEN=bitte-aendern

# Navidrome (optional, für Künstlerbilder/-infos): https://www.last.fm/api/account/create
LASTFM_APIKEY=
LASTFM_SECRET=
